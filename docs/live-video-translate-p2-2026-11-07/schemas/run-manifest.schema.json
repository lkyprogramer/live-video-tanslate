{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2 actual run manifest (not research catalog)",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "evidence_kind",
    "repository",
    "hardware",
    "locks",
    "datasets",
    "protocol",
    "fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_kind": {
      "const": "measured"
    },
    "repository": {
      "type": "object",
      "required": [
        "url",
        "head",
        "worktree_diff_sha256"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "worktree_diff_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hardware": {
      "type": "object",
      "required": [
        "chip",
        "memory_bytes",
        "gpu_cores",
        "os_version",
        "power_mode",
        "background_load"
      ],
      "properties": {
        "chip": {
          "type": "string"
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "os_version": {
          "type": "string"
        },
        "power_mode": {
          "type": "string"
        },
        "background_load": {
          "type": "string"
        }
      }
    },
    "locks": {
      "type": "object",
      "required": [
        "models_sha256",
        "runtime_sha256",
        "registry_sha256"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "manifest_sha256",
          "unit_count"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "unit_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "sample_rate",
        "channels",
        "encoding",
        "packet_samples",
        "clock",
        "reference_version"
      ],
      "properties": {
        "sample_rate": {
          "const": 16000
        },
        "channels": {
          "const": 1
        },
        "encoding": {
          "const": "s16le"
        },
        "packet_samples": {
          "const": 3200
        },
        "clock": {
          "const": "normalized_host_monotonic_ns"
        },
        "reference_version": {
          "type": "string"
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true,
  "$comment": "A non-M1 environment can validate the package but cannot label its runs as target-machine benchmarks."
}
