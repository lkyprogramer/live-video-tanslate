      "captions": [
        {
          "t_ms": 1795442936220,
          "media_time": 5.35,
          "text_zh": "你是在说“你好”吗？",
          "prev_zh": ""
        },
        {
          "t_ms": 1795442938019,
          "media_time": 7.14,
          "text_zh": "我以前也是会说“你好”的。",
          "prev_zh": "你是在说“你好”吗？"
        },
        {
          "t_ms": 1795442942720,
          "media_time": 11.85,
          "text_zh": "“亲切”这玩意儿不就是普通的打招呼吗？",
          "prev_zh": ""
        },
        {
          "t_ms": 1795442943220,
          "media_time": 12.35,
          "text_zh": "没什么意思吧？",
          "prev_zh": "“亲切”这玩意儿不就是普通的打招呼吗？"
        },
        {
          "t_ms": 1795442947918,
          "media_time": 17.05,
          "text_zh": "这么说起来，保育员啊。",
          "prev_zh": ""
        },
        {
          "t_ms": 1795442950120,
          "media_time": 19.25,
          "text_zh": "该把孩子接回家的父母，直接还给他们吧。",
          "prev_zh": "这么说起来，保育员啊。"
        },
        {
          "t_ms": 1795442954820,
          "media_time": 23.94,
          "text_zh": "下班回家的人很多，所以。",
          "prev_zh": ""
        },
        {
          "t_ms": 1795442956120,
          "media_time": 25.24,
          "text_zh": "早上要送一程。",
          "prev_zh": "下班回家的人很多，所以。"
        },
        {
          "t_ms": 1795442960820,
          "media_time": 29.95,
          "text_zh": "那我们也欢迎回来。",
          "prev_zh": ""
        },
        {
          "t_ms": 1795442963119,
          "media_time": 32.25,
          "text_zh": "绝对格拉拉拉拉。",
          "prev_zh": "那我们也欢迎回来。"
        },
        {
          "t_ms": 1795442966820,
          "media_time": 35,
          "text_zh": "窗口关门时的告别话术很难吗？",
          "prev_zh": ""
        }
      ],
