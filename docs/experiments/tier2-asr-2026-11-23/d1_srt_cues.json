[
  {
    "cue_id": 75,
    "timecode": "00:04:34,642 --> 00:04:36,577",
    "text_ja": "(春菜) 別に間違ってはないもんね｡"
  },
  {
    "cue_id": 76,
    "timecode": "00:04:36,644 --> 00:04:38,579",
    "text_ja": "(美樹) 私 ｢こんにちは｣って 言ってるよ｡"
  },
  {
    "cue_id": 77,
    "timecode": "00:04:38,646 --> 00:04:41,081",
    "text_ja": "(麻美) 私も前までは ｢こんにちは｣って 言ってたけどさ→"
  },
  {
    "cue_id": 78,
    "timecode": "00:04:41,148 --> 00:04:44,084",
    "text_ja": "一回キレられたんだよね なれなれしいっつって｡"
  },
  {
    "cue_id": 79,
    "timecode": "00:04:44,151 --> 00:04:47,087",
    "text_ja": ">> 普通に挨拶でしょ｡ (麻美) でしょ？ 意味分かんなくない？"
  },
  {
    "cue_id": 80,
    "timecode": "00:04:47,154 --> 00:04:49,089",
    "text_ja": "それは ひどいね｡"
  },
  {
    "cue_id": 81,
    "timecode": "00:04:49,156 --> 00:04:52,092",
    "text_ja": "そういえば 保育士さんって 子供迎えに来た親に→"
  },
  {
    "cue_id": 82,
    "timecode": "00:04:52,159 --> 00:04:55,095",
    "text_ja": "｢おかえりなさい｣って 言うんだって｡ (麻美) ふ～ん｡"
  },
  {
    "cue_id": 83,
    "timecode": "00:04:55,162 --> 00:04:58,098",
    "text_ja": ">> 仕事帰りの人が多いからだ｡ (美樹) そうそう で 朝は→"
  },
  {
    "cue_id": 84,
    "timecode": "00:04:58,165 --> 00:05:00,100",
    "text_ja": "｢いってらっしゃい｣って 送り出すんだって｡"
  },
  {
    "cue_id": 85,
    "timecode": "00:05:00,167 --> 00:05:02,102",
    "text_ja": "そのまんま仕事に行くからだ｡"
  },
  {
    "cue_id": 86,
    "timecode": "00:05:02,169 --> 00:05:04,538",
    "text_ja": "(麻美) じゃあ うちらも ｢おかえりなさい｣にする？"
  },
  {
    "cue_id": 87,
    "timecode": "00:05:04,605 --> 00:05:07,041",
    "text_ja": ">> 絶対キレられる｡ (麻美) 絶対キレられる｡"
  },
  {
    "cue_id": 88,
    "timecode": "00:05:07,107 --> 00:05:10,544",
    "text_ja": ">> あとさ 窓口の締めの挨拶って ムズくない？ (麻美) 分かるよ｡"
  },
  {
    "cue_id": 89,
    "timecode": "00:05:10,611 --> 00:05:13,547",
    "text_ja": "だって ｢ありがとうございました｣ じゃないもんね｡ >> そう｡"
  },
  {
    "cue_id": 90,
    "timecode": "00:05:13,614 --> 00:05:15,549",
    "text_ja": "｢お疲れさまでした｣って言うのも 変だしね｡"
  },
  {
    "cue_id": 91,
    "timecode": "00:05:15,616 --> 00:05:18,052",
    "text_ja": "しっくりくるのないよね｡ >> うん｡"
  },
  {
    "cue_id": 92,
    "timecode": "00:05:18,118 --> 00:05:20,054",
    "text_ja": "(麻美) じゃあ ｢いってらっしゃい｣にする？"
  },
  {
    "cue_id": 93,
    "timecode": "00:05:20,120 --> 00:05:22,556",
    "text_ja": ">> 絶対キレられる｡ (麻美) 絶対キレられる｡"
  }
]
